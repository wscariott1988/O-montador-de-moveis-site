---
import { getImage } from "astro:assets";
import BaseLayout from "../layouts/BaseLayout.astro";
import Header from "../components/Header.astro";
import Hero from "../components/Hero.astro";
import Stats from "../components/Stats.astro";
import Servicos from "../components/Servicos.astro";
import Sobre from "../components/Sobre.astro";
import Portfolio from "../components/Portfolio.astro";
import Avaliacoes from "../components/Avaliacoes.astro";
import Regioes from "../components/Regioes.astro";
import CtaFinal from "../components/CtaFinal.astro";
import Footer from "../components/Footer.astro";
import StickyWhatsApp from "../components/StickyWhatsApp.astro";
import { HERO_FOTO } from "../data/site";

const heroImagePreload = await getImage({ src: HERO_FOTO, width: 640 });
---

<BaseLayout preloadImage={heroImagePreload.src}>
  <Header />
  <main>
    <Hero />
    <Stats />
    <Servicos />
    <Sobre />
    <Portfolio />
    <Avaliacoes />
    <Regioes />
    <CtaFinal />
  </main>
  <Footer />
  <StickyWhatsApp />
</BaseLayout>
