---
import { NAV, SITE, whatsappUrl } from "../data/site";
const wa = whatsappUrl();
---

<header class="fixed top-0 left-0 w-full z-50 bg-surface/95 backdrop-blur-md border-b border-border-subtle shadow-sm">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 h-16 md:h-20 flex items-center justify-between gap-4">
    <a href="/" class="font-extrabold text-lg md:text-xl text-primary whitespace-nowrap">
      Willian <span class="text-amber">| O Montador de Móveis</span>
    </a>

    <nav class="hidden lg:flex items-center gap-8">
      {NAV.map((item) => (
        <a href={item.href} class="text-sm font-semibold text-muted hover:text-primary transition-colors">
          {item.label}
        </a>
      ))}
    </nav>

    <div class="flex items-center gap-3">
      <a
        href={wa}
        data-whatsapp-cta="header"
        class="hidden lg:inline-flex items-center gap-2 bg-primary text-white text-sm font-bold px-5 py-2.5 rounded-lg hover:bg-primary-light transition-colors shadow-sm"
      >
        <span class="material-symbols-outlined text-lg" aria-hidden="true">chat</span>
        Orçamento Rápido
      </a>
      <a
        href={wa}
        data-whatsapp-cta="header"
        aria-label="Orçamento no WhatsApp"
        class="lg:hidden inline-flex items-center justify-center w-10 h-10 rounded-lg bg-primary text-white"
      >
        <span class="material-symbols-outlined" aria-hidden="true">chat</span>
      </a>
    </div>
  </div>
</header>
