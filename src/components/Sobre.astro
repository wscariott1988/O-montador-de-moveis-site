---
import { Image } from "astro:assets";
import { SOBRE } from "../data/site";
---

<section id="sobre" class="scroll-mt-24 py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="grid md:grid-cols-2 gap-10 md:gap-14 items-center">
      <div class="order-1">
        <p class="text-xs font-bold uppercase tracking-widest text-amber">Quem sou eu</p>
        <h2 class="text-2xl md:text-4xl font-extrabold text-ink mt-2 mb-6">
          Experiência e profissionalismo em montagem de móveis
        </h2>
        {SOBRE.paragrafos.map((paragrafo) => (
          <p class="text-lg text-muted leading-relaxed mb-5 last:mb-0">{paragrafo}</p>
        ))}
      </div>
      <figure class="order-2">
        <Image
          src={SOBRE.img}
          alt={SOBRE.fotoAlt}
          sizes="(min-width:768px) 45vw, 100vw"
          widths={[480, 720, 960]}
          loading="lazy"
          decoding="async"
          class="w-full h-auto aspect-[4/5] object-cover rounded-2xl shadow-xl"
        />
      </figure>
    </div>
  </div>
</section>
