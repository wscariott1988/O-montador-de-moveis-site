---
import { STATS } from "../data/site";
---

<section class="border-y border-border-subtle bg-surface">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="grid grid-cols-2 divide-x divide-border-subtle">
      {STATS.map((stat) => (
        <div class="flex flex-col items-center text-center py-10 md:py-14 px-2">
          <span class="text-2xl md:text-4xl font-extrabold text-primary">{stat.value}</span>
          <span class="text-[11px] md:text-xs text-muted mt-2 uppercase tracking-wider text-center">{stat.label}</span>
        </div>
      ))}
    </div>
  </div>
</section>
