---
import { whatsappUrl } from "../data/site";
const wa = whatsappUrl();
---

<section id="regiao" class="scroll-mt-24 bg-surface-soft py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="text-center max-w-2xl mx-auto">
      <p class="text-xs font-bold uppercase tracking-widest text-amber">Região</p>
      <h2 class="text-2xl md:text-4xl font-extrabold text-ink mt-2">Atendimento em Novo Hamburgo e Vale dos Sinos</h2>
      <p class="text-lg text-muted mt-4">
        Atendo Novo Hamburgo e todo o Vale dos Sinos, garantindo um serviço limpo, pontual e profissional.
      </p>
      <div class="mt-8">
        <a
          href={wa}
          data-whatsapp-cta="regiao"
          class="inline-flex items-center justify-center gap-2 bg-whatsapp text-white font-bold px-8 py-4 rounded-lg hover:brightness-105 transition-all shadow-sm"
        >
          <span class="material-symbols-outlined">chat</span>
          Consultar Disponibilidade
        </a>
      </div>
    </div>
  </div>
</section>
