---
import { NAV, SITE, whatsappUrl } from "../data/site";
const wa = whatsappUrl();
const year = new Date().getFullYear();
---

<footer class="bg-surface border-t border-border-subtle">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6 py-10 md:py-12">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center gap-8">
      <div>
        <p class="text-lg font-extrabold text-primary">
          Willian <span class="text-amber">| O Montador de Móveis</span>
        </p>
        <p class="text-sm text-muted mt-2">© {year} Willian | O Montador de Móveis. Todos os direitos reservados.</p>
        <p class="text-xs text-faint mt-1">Atendemos Novo Hamburgo e todo o Vale dos Sinos</p>
      </div>

      <nav class="flex flex-wrap gap-x-6 gap-y-3">
        {NAV.map((item) => (
          <a href={item.href} class="text-sm text-muted hover:text-primary transition-colors">
            {item.label}
          </a>
        ))}
        <a href={wa} data-whatsapp-cta="footer" class="text-sm text-muted hover:text-primary transition-colors">
          Orçamento
        </a>
      </nav>
    </div>
  </div>
</footer>
