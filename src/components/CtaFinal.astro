---
import { SITE, whatsappUrl } from "../data/site";
const wa = whatsappUrl();
---

<section id="contato" class="scroll-mt-24 py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="bg-primary rounded-3xl p-8 md:p-16 text-center shadow-xl relative overflow-hidden">
      <div class="absolute top-0 left-0 w-64 h-64 bg-white/5 rounded-full -translate-x-1/2 -translate-y-1/2 blur-2xl"></div>
      <div class="absolute bottom-0 right-0 w-64 h-64 bg-amber/10 rounded-full translate-x-1/3 translate-y-1/3 blur-2xl"></div>

      <div class="relative z-10 max-w-2xl mx-auto">
        <div class="w-14 h-14 bg-white/10 rounded-full flex items-center justify-center mx-auto mb-6">
          <span class="material-symbols-outlined text-3xl text-white" aria-hidden="true">verified_user</span>
        </div>

        <h2 class="text-2xl md:text-4xl font-extrabold text-white mb-5">Peça seu orçamento pelo WhatsApp</h2>
        <p class="text-lg text-primary-fixed mb-8">Consulte valores e disponibilidade.</p>

        <a
          href={wa}
          data-whatsapp-cta="final"
          class="inline-flex items-center justify-center gap-2 bg-whatsapp text-white font-bold px-8 py-4 rounded-xl hover:brightness-105 transition-all shadow-[0_4px_20px_rgba(37,211,102,0.4)]"
        >
          <span class="material-symbols-outlined" aria-hidden="true">chat</span>
          Orçamento no WhatsApp
        </a>

        <div class="mt-8 flex flex-col sm:flex-row items-center justify-center gap-3 sm:gap-8 text-sm text-white/90">
          <span class="flex items-center gap-2">
            <span class="material-symbols-outlined text-amber" aria-hidden="true">chat</span>
            WhatsApp: {SITE.phoneDisplay}
          </span>
          <span class="flex items-center gap-2">
            <span class="material-symbols-outlined text-amber" aria-hidden="true">map</span>
            Atendo Novo Hamburgo e todo o Vale dos Sinos
          </span>
        </div>
      </div>
    </div>
  </div>
</section>
