---
import { PORTFOLIO, whatsappUrl } from "../data/site";
const wa = whatsappUrl();
---

<section id="trabalhos" class="scroll-mt-24 bg-surface-soft py-16 md:py-24">
  <div class="max-w-[1200px] mx-auto px-4 md:px-6">
    <div class="flex flex-col md:flex-row justify-between items-start md:items-end mb-10 gap-6">
      <div class="max-w-2xl">
        <p class="text-xs font-bold uppercase tracking-widest text-amber">Portfólio</p>
        <h2 class="text-2xl md:text-4xl font-extrabold text-ink mt-2">Meu Trabalho na Prática</h2>
        <p class="text-lg text-muted mt-3">
          Confira alguns projetos e montagens que realizei em Novo Hamburgo e região. Excelência e precisão em cada detalhe.
        </p>
      </div>
      <a
        href={wa}
        data-whatsapp-cta="portfolio"
        class="inline-flex items-center gap-2 bg-surface text-primary font-bold px-6 py-3 rounded-lg border border-border-subtle hover:bg-background transition-colors whitespace-nowrap shadow-sm"
      >
        Solicitar Orçamento
        <span class="material-symbols-outlined text-lg">arrow_forward</span>
      </a>
    </div>

    <div class="grid grid-cols-1 md:grid-cols-2 lg:grid-cols-3 gap-5">
      {PORTFOLIO.map((img) => (
        <figure class="rounded-2xl overflow-hidden shadow-sm group">
          <img
            src={img.src}
            width={img.width}
            height={img.height}
            alt={img.alt}
            loading="lazy"
            decoding="async"
            class="w-full h-64 md:h-72 object-cover group-hover:scale-105 transition-transform duration-500"
          />
        </figure>
      ))}
    </div>
  </div>
</section>
